// Mandi Connect — Full Prisma Schema
// Covers: Users, Products, Suppliers, Purchase Orders, Inventory,
//         Orders, Delivery, Billing, Payments, Audit Trail

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  DRIVER
  RECEIVER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum UnitType {
  KG
  GRAM
  BAG
  SACK
  PIECE
  BUNDLE
  LITRE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
}

enum OrderSource {
  RECEIVER_APP
  PHONE
  WHATSAPP
  WALK_IN
  OFFICE
}

enum OrderStatus {
  RECEIVED
  PENDING_APPROVAL
  CONFIRMED
  STOCK_RESERVED
  PICKING
  PACKED
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  REJECTED
  CANCELLED
  PARTIALLY_FULFILLED
  BACKORDERED
  DELIVERY_FAILED
  RETURNED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  ADVANCE
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  ADVANCE
  REFUNDED
}

enum StockMovementType {
  PURCHASE_IN         // Goods receipt accepted
  ORDER_RESERVATION   // Reserve stock for confirmed order
  RESERVATION_RELEASE // Release on cancel
  DISPATCH            // Order dispatched
  RETURN_IN           // Sales return (pending inspection)
  RETURN_APPROVED     // Return approved → back to stock
  WASTAGE             // Damage/waste recorded
  WAREHOUSE_TRANSFER  // Transfer between warehouses
  ADJUSTMENT          // Manual stock adjustment
  STOCK_COUNT         // Physical count correction
}

enum DeliveryStatus {
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  PARTIALLY_DELIVERED
  FAILED
  RETURNED
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  INACTIVE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  CANCEL
  DISPATCH
  PAYMENT
  ADJUSTMENT
}

// ─────────────────────────────────────────────────────────────
// USERS & ROLES
// ─────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  supabaseId    String   @unique // Supabase auth uid
  name          String
  email         String   @unique
  phone         String?
  role          UserRole
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  driver            Driver?
  createdOrders     Order[]          @relation("OrderCreatedBy")
  approvedOrders    Order[]          @relation("OrderApprovedBy")
  auditLogs         AuditLog[]
  stockAdjustments  StockMovement[]
  recordedPayments  Payment[]

  @@index([supabaseId])
  @@index([role])
}

// ─────────────────────────────────────────────────────────────
// CATEGORIES & PRODUCTS
// ─────────────────────────────────────────────────────────────

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  products    Product[]
}

model Unit {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  type            UnitType
  standardWeightKg Float?  // For bags/sacks: 1 bag = X kg
  isActive        Boolean  @default(true)

  products        Product[]
}

model Product {
  id            Int           @id @default(autoincrement())
  sku           String        @unique
  name          String
  description   String?
  imageUrl      String?
  categoryId    Int
  category      Category      @relation(fields: [categoryId], references: [id])
  unitId        Int
  unit          Unit          @relation(fields: [unitId], references: [id])
  purchasePrice Decimal       @db.Decimal(12, 2)
  sellingPrice  Decimal       @db.Decimal(12, 2)
  minMarginPct  Decimal?      @db.Decimal(5, 2)
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)
  hsnCode       String?
  // Rice-specific
  brand         String?
  variety       String?
  grade         String?
  bagWeightKg   Decimal?      @db.Decimal(8, 3)
  status        ProductStatus @default(ACTIVE)
  minStockLevel Decimal       @default(0) @db.Decimal(12, 3)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  priceHistory      PriceHistory[]
  customerPrices    CustomerPrice[]
  stockLedger       StockLedger[]
  stockMovements    StockMovement[]
  purchaseItems     PurchaseOrderItem[]
  goodsReceiptItems GoodsReceiptItem[]
  orderItems        OrderItem[]

  @@index([categoryId])
  @@index([status])
}

model PriceHistory {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  priceType   String   // 'PURCHASE' | 'SELLING'
  oldPrice    Decimal  @db.Decimal(12, 2)
  newPrice    Decimal  @db.Decimal(12, 2)
  changedById String
  reason      String?
  effectiveAt DateTime @default(now())

  @@index([productId, effectiveAt])
}

model CustomerPrice {
  id           Int      @id @default(autoincrement())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  productId    Int
  product      Product  @relation(fields: [productId], references: [id])
  price        Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([customerId, productId, effectiveFrom])
  @@index([customerId, productId])
}

// ─────────────────────────────────────────────────────────────
// CUSTOMERS (Receiver Companies)
// ─────────────────────────────────────────────────────────────

model Customer {
  id              String   @id @default(uuid())
  supabaseId      String?  @unique // if they have app login
  companyName     String
  contactPerson   String?
  phone           String
  email           String?
  address         String?
  city            String?
  gstNumber       String?
  creditLimit     Decimal  @default(0) @db.Decimal(12, 2)
  paymentTermDays Int      @default(0)
  openingBalance  Decimal  @default(0) @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  customerPrices CustomerPrice[]
  orders         Order[]
  invoices       Invoice[]
  payments       Payment[]
  ledger         CustomerLedger[]

  @@index([phone])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────
// SUPPLIERS
// ─────────────────────────────────────────────────────────────

model Supplier {
  id              Int            @id @default(autoincrement())
  name            String
  contactPerson   String?
  phone           String
  email           String?
  address         String?
  category        String?        // e.g. 'Vegetables', 'Rice', 'Grocery'
  gstNumber       String?
  panNumber       String?
  paymentTermDays Int            @default(0)
  openingBalance  Decimal        @default(0) @db.Decimal(12, 2)
  status          SupplierStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]
  ledger         SupplierLedger[]
}

// ─────────────────────────────────────────────────────────────
// PURCHASE ORDERS & GOODS RECEIPT
// ─────────────────────────────────────────────────────────────

model PurchaseOrder {
  id              Int                 @id @default(autoincrement())
  poNumber        String              @unique
  supplierId      Int
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  status          PurchaseOrderStatus @default(DRAFT)
  orderDate       DateTime            @default(now())
  expectedDate    DateTime?
  notes           String?
  transportCharge Decimal             @default(0) @db.Decimal(12, 2)
  otherCharges    Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal             @db.Decimal(14, 2)
  approvedById    String?
  approvedAt      DateTime?
  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       Int
  product         Product       @relation(fields: [productId], references: [id])
  orderedQty      Decimal       @db.Decimal(12, 3)
  receivedQty     Decimal       @default(0) @db.Decimal(12, 3)
  purchaseRate    Decimal       @db.Decimal(12, 2)
  amount          Decimal       @db.Decimal(14, 2)

  goodsReceiptItems GoodsReceiptItem[]
}

model GoodsReceipt {
  id               Int           @id @default(autoincrement())
  grNumber         String        @unique
  purchaseOrderId  Int
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receiptDate      DateTime      @default(now())
  supplierInvoiceNo String?
  invoiceFileUrl   String?
  notes            String?
  createdById      String
  createdAt        DateTime      @default(now())

  items GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id                Int          @id @default(autoincrement())
  goodsReceiptId    Int
  goodsReceipt      GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  purchaseItemId    Int
  purchaseItem      PurchaseOrderItem @relation(fields: [purchaseItemId], references: [id])
  productId         Int
  product           Product      @relation(fields: [productId], references: [id])
  orderedQty        Decimal      @db.Decimal(12, 3)
  receivedQty       Decimal      @db.Decimal(12, 3)
  acceptedQty       Decimal      @db.Decimal(12, 3)
  damagedQty        Decimal      @default(0) @db.Decimal(12, 3)
  rejectedQty       Decimal      @default(0) @db.Decimal(12, 3)
  actualWeightKg    Decimal?     @db.Decimal(12, 3)
  purchaseRate      Decimal      @db.Decimal(12, 2)
  warehouseId       Int
  warehouse         Warehouse    @relation(fields: [warehouseId], references: [id])
  batchNumber       String?
  expiryDate        DateTime?
}

// ─────────────────────────────────────────────────────────────
// WAREHOUSES & INVENTORY
// ─────────────────────────────────────────────────────────────

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockLedger       StockLedger[]
  stockMovements    StockMovement[]
  goodsReceiptItems GoodsReceiptItem[]
  orderItems        OrderItem[]
  sourceTransfers   WarehouseTransfer[] @relation("SourceWarehouse")
  destTransfers     WarehouseTransfer[] @relation("DestWarehouse")
}

model StockLedger {
  id              Int       @id @default(autoincrement())
  productId       Int
  product         Product   @relation(fields: [productId], references: [id])
  warehouseId     Int
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  physicalQty     Decimal   @default(0) @db.Decimal(14, 3) // Total physical on hand
  reservedQty     Decimal   @default(0) @db.Decimal(14, 3) // Reserved for confirmed orders
  availableQty    Decimal   @default(0) @db.Decimal(14, 3) // physicalQty - reservedQty
  wastedQty       Decimal   @default(0) @db.Decimal(14, 3)
  avgCostPrice    Decimal   @default(0) @db.Decimal(12, 2)
  updatedAt       DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

model StockMovement {
  id             Int               @id @default(autoincrement())
  idempotencyKey String            @unique // Prevent duplicate movements
  productId      Int
  product        Product           @relation(fields: [productId], references: [id])
  warehouseId    Int
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  movementType   StockMovementType
  qtyChange      Decimal           @db.Decimal(14, 3) // Positive = in, Negative = out
  qtyBefore      Decimal           @db.Decimal(14, 3)
  qtyAfter       Decimal           @db.Decimal(14, 3)
  referenceType  String?           // 'ORDER', 'PURCHASE', 'ADJUSTMENT', etc.
  referenceId    String?
  reason         String?
  approvedById   String?
  createdById    String
  createdBy      User              @relation(fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())

  @@index([productId, warehouseId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model WarehouseTransfer {
  id              Int       @id @default(autoincrement())
  transferNo      String    @unique
  sourceWarehouseId Int
  sourceWarehouse   Warehouse @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destWarehouseId   Int
  destWarehouse     Warehouse @relation("DestWarehouse", fields: [destWarehouseId], references: [id])
  productId       Int
  qty             Decimal   @db.Decimal(12, 3)
  notes           String?
  approvedById    String?
  transferDate    DateTime  @default(now())
  createdAt       DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────────────────

model Order {
  id              Int         @id @default(autoincrement())
  orderNo         String      @unique // e.g. ORD-2026-08924
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  source          OrderSource @default(OFFICE)
  status          OrderStatus @default(RECEIVED)
  orderDate       DateTime    @default(now())
  requiredDate    DateTime?
  notes           String?
  rejectionReason String?

  // Pricing
  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal @default(0) @db.Decimal(14, 2)

  // Payment
  paymentStatus PaymentStatus @default(UNPAID)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2)
  balanceDue    Decimal       @default(0) @db.Decimal(14, 2)

  // Staff
  createdById  String
  createdBy    User    @relation("OrderCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?   @relation("OrderApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @updatedAt
  updatedAt DateTime @updatedAt

  // Relations
  items       OrderItem[]
  invoices    Invoice[]
  payments    Payment[]
  deliveries  DeliveryTripOrder[]
  statusLogs  OrderStatusLog[]

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id])
  productId   Int
  product     Product @relation(fields: [productId], references: [id])
  warehouseId Int?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  orderedQty    Decimal @db.Decimal(12, 3)
  confirmedQty  Decimal @default(0) @db.Decimal(12, 3)
  reservedQty   Decimal @default(0) @db.Decimal(12, 3)
  pickedQty     Decimal @default(0) @db.Decimal(12, 3)
  dispatchedQty Decimal @default(0) @db.Decimal(12, 3)
  deliveredQty  Decimal @default(0) @db.Decimal(12, 3)
  returnedQty   Decimal @default(0) @db.Decimal(12, 3)
  remainingQty  Decimal @default(0) @db.Decimal(12, 3)

  unitPrice  Decimal @db.Decimal(12, 2) // Locked at time of confirmation
  taxRate    Decimal @default(0) @db.Decimal(5, 2)
  taxAmount  Decimal @default(0) @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(14, 2)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusLog {
  id        Int         @id @default(autoincrement())
  orderId   Int
  order     Order       @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus?
  toStatus  OrderStatus
  notes     String?
  changedById String
  changedAt DateTime    @default(now())

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// DELIVERY & DRIVERS
// ─────────────────────────────────────────────────────────────

model Driver {
  id          Int     @id @default(autoincrement())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id])
  licenceNo   String?
  licenceType String?
  isActive    Boolean @default(true)

  vehicles    DriverVehicle[]
  trips       DeliveryTrip[]
}

model Vehicle {
  id            Int           @id @default(autoincrement())
  vehicleNo     String        @unique
  vehicleType   String        // e.g. 'Mini Truck', 'Tempo', 'Van'
  capacityKg    Decimal       @db.Decimal(10, 2)
  status        VehicleStatus @default(AVAILABLE)
  isActive      Boolean       @default(true)

  drivers  DriverVehicle[]
  trips    DeliveryTrip[]
}

model DriverVehicle {
  id        Int     @id @default(autoincrement())
  driverId  Int
  driver    Driver  @relation(fields: [driverId], references: [id])
  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  isDefault Boolean @default(false)

  @@unique([driverId, vehicleId])
}

model DeliveryTrip {
  id           Int            @id @default(autoincrement())
  tripNo       String         @unique
  driverId     Int
  driver       Driver         @relation(fields: [driverId], references: [id])
  vehicleId    Int
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id])
  dispatchTime DateTime?
  returnTime   DateTime?
  notes        String?
  totalLoadKg  Decimal        @default(0) @db.Decimal(12, 2)
  createdAt    DateTime       @default(now())

  orders      DeliveryTripOrder[]
  collections DeliveryCollection[]
}

model DeliveryTripOrder {
  id             Int           @id @default(autoincrement())
  tripId         Int
  trip           DeliveryTrip  @relation(fields: [tripId], references: [id])
  orderId        Int
  order          Order         @relation(fields: [orderId], references: [id])
  deliverySeq    Int           // Sequence in trip
  status         DeliveryStatus @default(ASSIGNED)

  // POD — Proof of Delivery
  deliveredAt      DateTime?
  receiverName     String?
  receiverSignUrl  String?
  podPhotoUrl      String?
  deliveredQtyNote String?
  shortageNote     String?
  returnNote       String?
  failureReason    String?
  remarks          String?

  @@unique([tripId, orderId])
  @@index([tripId])
  @@index([orderId])
}

model DeliveryCollection {
  id            Int           @id @default(autoincrement())
  tripId        Int
  trip          DeliveryTrip  @relation(fields: [tripId], references: [id])
  customerId    String
  orderId       Int?
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?
  collectedAt   DateTime      @default(now())
  remittedToOffice Boolean    @default(false)
  remittedAt    DateTime?
}

// ─────────────────────────────────────────────────────────────
// BILLING & INVOICES
// ─────────────────────────────────────────────────────────────

model Invoice {
  id             Int       @id @default(autoincrement())
  invoiceNo      String    @unique // e.g. INV-2026-001
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  orderId        Int?
  order          Order?    @relation(fields: [orderId], references: [id])
  invoiceDate    DateTime  @default(now())
  dueDate        DateTime?
  subtotal       Decimal   @db.Decimal(14, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(14, 2)
  discountAmount Decimal   @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal   @db.Decimal(14, 2)
  amountPaid     Decimal   @default(0) @db.Decimal(14, 2)
  balanceDue     Decimal   @db.Decimal(14, 2)
  paymentStatus  PaymentStatus @default(UNPAID)
  notes          String?
  pdfUrl        String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payments Payment[]
  items    InvoiceItem[]

  @@index([customerId])
  @@index([paymentStatus])
  @@index([invoiceDate])
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  productId   Int?
  description String
  qty         Decimal @db.Decimal(12, 3)
  unit        String
  rate        Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(14, 2)
}

// ─────────────────────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────────────────────

model Payment {
  id          Int           @id @default(autoincrement())
  paymentRef  String        @unique // e.g. PAY-2026-001
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  orderId     Int?
  order       Order?        @relation(fields: [orderId], references: [id])
  invoiceId   Int?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id])
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod
  reference   String?       // UPI txn ID, cheque no, bank ref
  paymentDate DateTime      @default(now())
  notes       String?
  receiptUrl  String?
  recordedById String
  recordedBy   User         @relation(fields: [recordedById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([customerId])
  @@index([invoiceId])
  @@index([paymentDate])
}

model CustomerLedger {
  id          Int       @id @default(autoincrement())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  entryDate   DateTime  @default(now())
  entryType   String    // 'INVOICE', 'PAYMENT', 'CREDIT_NOTE', 'ADJUSTMENT'
  referenceId String?
  description String
  debit       Decimal   @default(0) @db.Decimal(14, 2)
  credit      Decimal   @default(0) @db.Decimal(14, 2)
  balance     Decimal   @db.Decimal(14, 2)

  @@index([customerId, entryDate])
}

// ─────────────────────────────────────────────────────────────
// SUPPLIER PAYMENTS & LEDGER
// ─────────────────────────────────────────────────────────────

model SupplierPayment {
  id           Int           @id @default(autoincrement())
  paymentRef   String        @unique
  supplierId   Int
  supplier     Supplier      @relation(fields: [supplierId], references: [id])
  amount       Decimal       @db.Decimal(14, 2)
  method       PaymentMethod
  reference    String?
  paymentDate  DateTime      @default(now())
  notes        String?
  receiptUrl   String?
  recordedById String
  createdAt    DateTime      @default(now())

  @@index([supplierId])
}

model SupplierLedger {
  id          Int      @id @default(autoincrement())
  supplierId  Int
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  entryDate   DateTime @default(now())
  entryType   String   // 'PURCHASE', 'PAYMENT', 'ADJUSTMENT'
  referenceId String?
  description String
  debit       Decimal  @default(0) @db.Decimal(14, 2)
  credit      Decimal  @default(0) @db.Decimal(14, 2)
  balance     Decimal  @db.Decimal(14, 2)

  @@index([supplierId, entryDate])
}

// ─────────────────────────────────────────────────────────────
// AUDIT TRAIL
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id           Int         @id @default(autoincrement())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  action       AuditAction
  entityType   String      // 'ORDER', 'PRODUCT', 'PAYMENT', 'STOCK', etc.
  entityId     String
  fieldChanged String?
  oldValue     String?     @db.Text
  newValue     String?     @db.Text
  ipAddress    String?
  userAgent    String?
  notes        String?
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  title     String
  body      String
  type      String   // 'ORDER', 'STOCK', 'PAYMENT', 'DELIVERY', etc.
  refType   String?
  refId     String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}
