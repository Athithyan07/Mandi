{
  "name": "mandi-connect",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "node scripts/dev.mjs backend",
    "dev:frontend": "node scripts/dev.mjs frontend",
    "build": "turbo build",
    "build:backend": "pnpm --filter @mandi/backend run build",
    "build:frontend": "pnpm --filter office run build",
    "lint": "turbo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "db:deploy": "turbo db:deploy",
    "db:studio": "cd packages/db && npx prisma studio"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "prettier": "^3.4.2",
    "supertest": "^7.3.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "20.x"
  }
}
