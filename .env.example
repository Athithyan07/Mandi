# ==============================================================================
# MANDI CONNECT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit real secrets or production .env files to version control!

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE CONNECTION (Prisma ORM)
# ------------------------------------------------------------------------------
# In your Supabase dashboard: Project Settings -> Database -> Connection string
# 
# DATABASE_URL (Transaction Pooler - Supavisor/PgBouncer, Port 6543):
# Used by your application runtime for pooled queries.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL (Session Pooler / Direct Connection, Port 5432):
# Used by Prisma CLI for running migrations and schema introspections.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE API & AUTHENTICATION
# ------------------------------------------------------------------------------
# In your Supabase dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. BACKEND & API CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:5000"
CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"

